{
  "app": {
    "defaultViewMode": "preview",
    "showInlineTitle": false,
    "readableLineLength": true,
    "strictLineBreaks": false,
    "showFrontmatter": false,
    "propertiesInDocument": "hidden",
    "alwaysUpdateLinks": false,
    "newFileLocation": "root",
    "promptDelete": true,
    "useMarkdownLinks": false
  },
  "appearance": {
    "enabledCssSnippets": [
      "ela"
    ]
  },
  "core_on": [
    "backlink",
    "bases",
    "bookmarks",
    "command-palette",
    "file-explorer",
    "file-recovery",
    "global-search",
    "graph",
    "outgoing-link",
    "outline",
    "page-preview",
    "properties",
    "switcher"
  ],
  "community": [
    "homepage",
    "obsidian-html-plugin"
  ],
  "bookmarks": [
    {
      "path": "home.md",
      "title": "Home"
    },
    {
      "path": "readme.md",
      "title": "About this vault"
    }
  ],
  "plugins": {
    "homepage": {
      "version": "4.5.0",
      "repo": "mirnovov/obsidian-homepage",
      "files": [
        "main.js",
        "manifest.json",
        "styles.css"
      ]
    },
    "obsidian-html-plugin": {
      "version": "1.0.19",
      "repo": "nuthrash/obsidian-html-plugin",
      "files": [
        "main.js",
        "manifest.json"
      ]
    }
  }
}