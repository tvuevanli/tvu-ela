#!/usr/bin/env python3
"""ela — the owner's assistant at the shell. One word, short verbs, no Claude session needed.

  ela <id|url>                     the shortest form, by shape: MH-3568 · 01M1GD1F… (graph)
                                   · 32-hex (process, then tangible) · 19 digits (object)
                                   · a Slack permalink · a Jira URL · a Confluence page URL
                                   · a Google Doc/Sheet URL

知道 — read first-hand
 tickets & threads
  ela jira read|files|jql …        a ticket, a JQL search; files: its attachments to disk
  ela slack <verb> …               read|files|channels|history|mentions|unanswered|whoami|users;
                                   files: a thread's images to disk; channels --all: every public
                                   channel, joined or not
  ela mail search|read|thread …    Gmail, read-only: QA test reports, deploy notices, approvals
  ela wiki <verb> …                Confluence, read-only: spaces|tree|search|read|children;
                                   also ela confluence …; a page URL alone works
  ela gdoc read|sheet|list|info …  Google Docs/Sheets/Drive, read-only; a docs.google.com URL
                                   alone works
  ela kb search|read|tree …        Outline, the knowledge base (its writes are listed below)
  ela api <verb> …                 Apifox API definitions, read-only: projects|export|tags|list|
                                   read|schema · ela api read ur "GET /v1beta1/graphs/{graphId}"
  ela figma <verb> …               a Figma design first-hand: me|file|node|comments|image
  ela sentry <verb> …              crashes and errors, read-only: projects|issues|issue|events
 graphs & streams
  ela graph <id> [-d] [-c]         node table in pipeline order; -d box location/id + image,
                                   -c connections (env read from the data)
  ela process <id>                 one process's live record
  ela box <id> [-d]                a box; -d: who holds which port, orphans flagged
  ela graphs [me|li|email]         a user's graphs (default: me)
  ela resolve <id> [--email …]     32-hex: process, then tangible · 19 digits: object → its graphs
  ela envs                         the UR probe order
  ela object <id>                  object or tangible
  ela stream probe <url>           what a stream carries: PMT · PCR · PID table · codec
                                   (m3u8 · .ts · srt:// · udp://)
  ela stream diff <a> <b>          two streams, field by field
 logs
  ela logs chain <traceId>         read-only: a trace's hops, the first failing one marked
  ela logs java|calls …            own lines: java --trace T|--app A --at T; calls --server S --at T
  ela logs loki --pid P            a media process's Loki lines; tvulog needs `ela login tvu`
 code & map
  ela find <name>                  repos, images, services matching: J2N type · slug · GM name, tied
  ela where <ref>                  the checkout path(s) of an alias/path, repo, slug or image
  ela coverage                     is the code usually needed on disk? docker · app · UR/J2N
  ela services                     the service table (--image X | --type T)
  ela missing                      the map's absent entries, one line each
  ela remote <alias> [grep]        a remote's project list: every project of that GitLab group
                                   (read token); ● on disk ○ not cloned
  ela survey                       scan the code, work and lab roots into the survey cache
  ela probe <alias/path>…          does that remote path exist? (ls-remote; not /ela:probe)
  ela sync <repo> [--ref R]        fetch; branch, ahead/behind, dirty; optionally check out R
  ela clone <alias/path>           clone into its place under <code>
 release facts
  ela bundles [mh2.1@]             GM bundles, newest first
  ela bundle <name|id>             its bill of materials
  ela bundle-diff <A> <B>          docker services added/removed/changed between two bundles
                                   (name, id or prefix; --host-a/--host-b)
  ela versions [service]           versions per env (userservice)
  ela builds <job|service>         Jenkins builds: version, branch, sha
  ela drift                        newest bundle's GM names vs services.yaml
  ela promote <line> <from> <to>   the promotion assessment, ranked
                                   [--purpose regular|prod-staging|demo] [--scope app|all]
                                   [--bundles] [--out DIR]; or one part of it:
                                   promote lanes|commits|tickets|evidence|bundles <line> <from> <to>
 earlier work
  ela sessions <word>…             earlier sessions on this machine whose first prompt or final
                                   answer carries every word

协调 — facts and drafts for the team
  ela brief [--lane L]             the morning brief's Jira lanes, flags computed: cadence ·
                                   triage · breakdown · incidents · backlog · yours
  ela route <KEY>                  the routing facts: [Layer] token, ids, signal words per layer,
                                   services named, who to ask first, gaps
  ela fixed-in <KEY>… [--jql Q]    the Fixed In the evidence supports: commits → build → lanes
                                   → QA words; draft only, no Jira write
  ela team <verb>                  the roster, first-hand: people|areas|who|emails|check
  ela who <person>                 one person by name, email, Uxxx or accountId; exit 3 when unknown
  ela publish <what>               render an elak source into <published> for machines to read:
                                   catalogue|roster|map|all|list; the manifest row records it
  ela reports list|build           the owner's standing reports (markdown → HTML; a session
                                   publishes them as artifacts)

动手 — the owner's own change
  ela worktree <repo> <KEY>        branch evan/<key> in <work>/<KEY>/<repo>
  ela mr <KEY> <repo> [--lane B]   the push and the merge-request request for evan/<key>,
                                   dry run only
  ela mr-preflight [--host H]      each GitLab token's scopes and expiry (needs scope api)

运行操作 — writes on a live system, each behind a confirm
  ela connect <ip|box|process>     ssh to the box (root)
  ela exec <process>               docker exec into it
  ela start <process> …            --url U --format F --shm S; a Sender working process; asks y/N
  ela stop <process>               stop a Sender working process; asks y/N
  writes elsewhere:                jira comment|transition|label|link|assign|create|create-subtask,
                                   slack post (a permalink replies in-thread), kb write|update|
                                   delete (on the owner's word) — dry run until --apply

站点
  ela login tvu|qa                 prod: a one-time HTTPS page collects the browser's SID;
                                   then --host prod on bundles, bundle, versions, drift
  ela site                         the site config: roots, host names, aliases, emails
  ela runtime status|clean         the disposable working directory: what is there, and delete
                                   it (--work also drops clean worktrees)

Every verb forwards to skills/<cap>/<cap>.py with the site's env file.
`--json` works everywhere.
Exit codes: 0 ok · 2 usage · 3 not found · 4 auth · 5 remote.
"""
import json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SITE = os.path.expanduser("~/.claude/ela/site.json")

# verb → (capability, subcommand or None = pass verb through)
VERBS = {
    "graph": ("graph", "graph"), "process": ("graph", "process"), "box": ("graph", "box"),
    "graphs": ("graph", "graphs"), "resolve": ("graph", "resolve"), "envs": ("graph", "envs"),
    "connect": ("graph", "connect"), "exec": ("graph", "exec"), "start": ("graph", "start"), "stop": ("graph", "stop"),
    "jira": ("jira", None), "slack": ("slack", None), "object": ("object", "get"),
    "find": ("map", "find"), "where": ("map", "where"), "probe": ("map", "probe"), "clone": ("map", "clone"),
    "sync": ("map", "sync"), "worktree": ("map", "worktree"), "survey": ("map", "survey"),
    "coverage": ("map", "coverage"), "remote": ("map", "remote"), "missing": ("map", "missing"), "services": ("map", "services"),
    "kb": ("kb", None), "figma": ("figma", None),
    "bundles": ("release", "bundles"), "bundle": ("release", "bundle"), "bundle-diff": ("release", "bundle-diff"),"versions": ("release", "envs"), "builds": ("release", "builds"),
    "drift": ("release", "drift"), "release": ("release", None),
    "confluence": ("confluence", None), "wiki": ("confluence", None), "gdoc": ("gdoc", None),
    "reports": ("reports", None), "api": ("apifox", None), "apifox": ("apifox", None), "publish": ("publish", None),
    "team": ("team", None), "who": ("team", "who"),
    "mail": ("mail", None), "login": ("release", "login"), "stream": ("stream", None),
    "sentry": ("sentry", None),
    "promote": ("promote", None), "runtime": ("runtime", None),
    "brief": ("brief", "lanes"),
    "mr": ("mr", "create"), "mr-preflight": ("mr", "preflight"),
    "sessions": ("sessions", "find"),
    "route": ("route", "facts"),
    "fixed-in": ("fixedin", "draft"),
    "logs": ("logs", None),
}
PROMOTE_SUBS = {"lanes", "commits", "delta", "tickets", "evidence", "bundles", "report", "compare-helm"}


def site():
    try:
        return json.load(open(SITE))
    except Exception:
        sys.exit("no ~/.claude/ela/site.json — run /ela:setup in a Claude session")


def run(cap, args, env_file):
    script = os.path.join(ROOT, "skills", cap, f"{cap}.py")
    if not os.path.isfile(script):
        sys.exit(f"capability {cap} has no script yet ({script})")
    argv = ["python3", script, "--env-file", env_file, *args] if cap not in ("map", "reports", "publish", "stream", "runtime", "sessions") else ["python3", script, *args]
    os.execvp(argv[0], argv)


def by_shape(token):
    if re.fullmatch(r"[A-Z][A-Z0-9]+-\d+", token) or "atlassian.net/browse/" in token:
        return "jira", ["read", token]
    if "slack.com/archives/" in token:
        return "slack", ["read", token]
    if re.fullmatch(r"[0-9A-Z]{26}", token):
        return "graph", ["graph", token]
    if re.fullmatch(r"[0-9a-f]{32}", token):
        return "graph", ["resolve", token]          # process first; graph.py says when to try the tangible
    if re.fullmatch(r"\d{19}", token):
        return "graph", ["resolve", token]          # object → its running graphs
    if re.fullmatch(r"[0-9a-f]{16}", token):
        return "object", ["get", token]
    if "app.apifox.com/project/" in token:
        return "apifox", ["list", token]
    if "docs.google.com/spreadsheets/" in token:
        return "gdoc", ["sheet", token]
    if "docs.google.com/document/" in token or "drive.google.com/" in token:
        return "gdoc", ["read", token]
    conf = ((site().get("services") or {}).get("confluence") or {}).get("url")
    if (conf and token.startswith(conf)) or "pageId=" in token:
        return "confluence", ["read", token]
    return None, None


def show_env(s):
    print(f"projects  {s.get('projects')}")
    for k in ("code", "work", "lab", "elak", "map", "env"):
        print(f"{k:<9} {s.get(k) or '(default)'}")
    print("hosts     " + ", ".join(s.get("hosts", {})) )
    print("aliases   " + ", ".join(f"{k}→{v.get('host','?')}/{v.get('group','')}" for k, v in s.get("aliases", {}).items()))
    print("emails    " + ", ".join(f"{k}={v}" for k, v in s.get("emails", {}).items()))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    s = site()
    env_file = s.get("env") or os.path.expanduser("~/.claude/ela/.env")
    verb, rest = args[0], args[1:]
    if verb == "site":
        show_env(s); return
    if verb in VERBS:
        cap, sub = VERBS[verb]
        if verb == "promote" and rest and rest[0] not in PROMOTE_SUBS and not rest[0].startswith("-"):
            rest = ["report", *rest]                      # ela promote 2.1 qa daily → the full report; a subcommand name is passed through
        run(cap, ([sub] if sub else []) + rest, env_file)
    cap, argv = by_shape(verb)
    if cap:
        run(cap, argv + rest, env_file)
    sys.exit(f"ela: unknown verb or id shape: {verb!r}. Try `ela help`.")


if __name__ == "__main__":
    main()
