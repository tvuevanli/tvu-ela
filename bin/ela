#!/usr/bin/env python3
"""ela — the owner's assistant at the shell. One word, short verbs, no Claude session needed.

  ela <id|url>                     the shortest form, by shape: MH-3568 · 01M1GD1F… (graph)
                                   · 32-hex (process, then tangible) · 19 digits (object)
                                   · a Slack permalink · a Jira URL · a Confluence page URL
                                   · a Google Doc/Sheet URL

知道 — read first-hand
 tickets & threads
  ela jira read|files|jql …        a ticket, a JQL search; files: its attachments to disk
  ela jira projects|changes …      every project key the account sees; tickets changed since a time
  ela slack <verb> …               read|files|channels|history|search|mentions|unanswered|whoami|users|check;
                                   files: a thread's images to disk; channels --all: every public
                                   channel, joined or not; check --text|--file [--fix]: is this text
                                   Slack mrkdwn (exit 1 names each slip; no token, no call)
  ela mail search|read|thread …    Gmail, read-only: QA test reports, deploy notices, approvals
  ela facts runtime show|prove <graph>  a lane's real profile chain, proven by a graph's creator and gateway
  ela facts refresh|status         the fact store (<runtime>/facts/): every source read once per pass, dated; the read
                                   verbs serve it while fresh and print its time; --source jira|slack|mail|lanes|builds|runtime,
                                   --fresh re-reads whole; a verb's own --fresh reads its source now
  ela facts calls [--date D]       a day's live calls: the fixed reads, and the rest by caller and verb
  ela wiki <verb> …                Confluence, read-only: spaces|tree|search|read|children;
                                   also ela confluence …; a page URL alone works
  ela gdoc read|sheet|list|info …  Google Docs/Sheets/Drive, read-only; a docs.google.com URL
                                   alone works
  ela kb search|read|tree …        Outline, the knowledge base (its writes are listed below)
  ela tvukb image|version|find|card|… the media team's tvu-kb, run in its checkout, headed tvu-kb@<sha>:
                                   a media image tag or program version → the build's module commits
  ela api <verb> …                 API definitions, read-only — Apifox projects and the public doc
                                   (public): projects|export|tags|list|read|schema|diff ·
                                   ela api read ur "GET /v1beta1/graphs/{graphId}" ·
                                   ela api diff public 4283785 --tag "MediaHub API"
  ela figma <verb> …               a Figma design first-hand: me|file|node|comments|image
  ela sentry <verb> …              crashes and errors, read-only: projects|issues|issue|events
 graphs & streams
  ela graph <id> [-d] [-c]         node table in pipeline order; -d box location/id + image,
                                   -c connections (env read from the data)
  ela process <id>                 one process's live record
  ela box <id> [-d]                a box; -d: who holds which port, orphans flagged
  ela graphs [me|li|email]         a user's graphs (default: me)
  ela resolve <id> [--email …]     32-hex: process, then tangible · 19 digits: object → its graphs
  ela usage <type> [--days N] [--external] [--by week|day|user]
                                   who created graphs holding a node type (youtube · webemulator · any J2N
                                   process type) over the last N days, per week and per owner; -e prod3
                                   (default) · test2 · cn2; no type: the types seen, with counts
  ela envs                         the UR probe order
  ela object <id>                  object or tangible
  ela grid <name|pid|source|object> a Grid source end to end, read-only: sender (CC) · encoders and
                                   routes (GCS) · paired receivers live on it · where it breaks; --region cn
  ela stream probe <url>           what a stream carries: PMT · PCR · PID table · codec
                                   (m3u8 · .ts · srt:// · udp://)
  ela stream diff <a> <b>          two streams, field by field
  ela stream audio <ts|url>        which channel sounds, per slice: RMS L/R · L−R · correlation · silence
                                   (a remap checked on the output; a live URL takes --seconds)
 logs
  ela logs chain <traceId>         read-only: a trace's hops, the first failing one marked
  ela logs java|calls …            own lines: java --trace T|--app A --at T; calls --server S --at T
  ela logs loki --pid P            a media process's Loki lines; tvulog needs `ela login tvu`
  ela configserver <verb> …        Config Server, read-only, values redacted: apps|profiles|get|
                                   effective|search|history · effective <app> <profile> --key k
  ela j2n scores <env> [--subtype S] [--labels k=v,…] [--diff <env>]
                                   J2N's scheduling scores through the J2N config UI, read-only: what one app
                                   instance costs a box (Cpu, Qsv…) per label set; --diff: the compare view
  ela j2n envs                     its environments and the owner's access to each (write on qa/qa2: never used)
  ela browser env [--lane L] [--key K]  the version panel vs the release map, and the lanes carrying K's fix:
                                   the environment proof (exit 6: the fix is not on this lane)
  ela browser run <case.js>        one browser case as the owner's session; --phase create|observe --state F
                                   for a scheduled behaviour; shot <url> --out F
  ela verify --key K --run DIR     render the verification report page from a run directory (<reports>/verify/)
  ela verify-plan --key K --plan F --lane L --version V
                                   an unattended run's plan, kept beside its results (a reading); nothing waits on it
 code & map
  ela find <name>                  repos, images, services matching: J2N type · slug · GM name, tied
  ela where <ref>                  the checkout path(s) of an alias/path, repo, slug or image
  ela coverage                     is the code usually needed on disk? docker · app · UR/J2N
  ela services                     the service table (--image X | --type T)
  ela missing                      the map's absent entries, one line each
  ela remote <alias> [grep]        a remote's project list: every project of that GitLab group
                                   (read token); ● on disk ○ not cloned
  ela survey                       scan the code, work and lab roots into the survey cache
  ela probe <alias/path>…          does that remote path exist? (ls-remote; not /ela:probe)
  ela sync <repo> [--ref R]        fetch; branch, ahead/behind, dirty; optionally check out R
  ela clone <alias/path>           clone into its place under <code>
 release facts
  ela bundles [mh2.1@]             GM bundles, newest first: every host (qa, prod, cn = the China region's), each
                                   row with its host and read time; --host H for one; --host cn --raw: its names as read
  ela bundle <name|id>             its bill of materials
  ela bundle-diff <A> <B>          docker services added/removed/changed between two bundles
                                   (name, id or prefix; --host-a/--host-b qa|prod|cn)
  ela docker [--image I] [--page]   media docker services (releases/media-docker-services.md): per image of the lines
                                   in `docker_lines`, which version can move to which lane, every version since a lane's
                                   with its changes, QA verdict and mails; the bundle command per daily lane, folded
  ela versions [service]           versions per lane (userservice): every host, or --host qa|prod|cn; a China
                                   tag the release map does not name is shown as read, unmapped
  ela release gateway [service]    versions userservice does not publish (orchestration), per lane via the API
                                   gateways; [--lane L] [--json]; a lane that does not answer is UNDETERMINED
  ela builds <job|service>         Jenkins builds: version, branch, sha
  ela drift                        newest bundle's GM names vs services.yaml
  ela release create [name] --from <base> --set "<svc>=<tag>" [--drop svc] [--note "why"] [--apply]
                                   a new GM bundle on prod from a base: the diff, a description written from it,
                                   the lane order (QA ≥ daily ≥ prod); --apply posts and reads it back. Never deletes
  ela release pin <line> <bundle> --why "…"
                                   hold prod on an older official bundle (prod follows the newest otherwise);
                                   dry run unless --apply, which commits that one file (ADR 0013)
  ela release unpin <line>         lift the hold · ela release pins: the holds in force
  ela release next [--write] [--json]  the next release as data: base, candidate (newest daily, --pin, --candidate),
                                   release:must with lane cells, tickets on the candidate with QA's verdict, in
                                   development, docker; --write → <published>/releases/next.json (schema: README.md beside it);
                                   --sync then carries releases/ to Helm Akamai
  ela release changes [lane]       what a lane's newest build changed: one line per service and what for, from
                                   its record (<reports>/releases/<line>/); --check FILE validates a record
  ela release reconcile <lane> [--build N]  the build's tickets against Jira, read-only: Fixed In covering this
                                   build's version per service (bare = +BUILD), the release label, the status and
                                   assignee the release thread announced; a revert folded into another ticket is an
                                   open question. --batch: the appends and labels, dry run unless --apply
  ela promote <line> <from> <to>   the promotion assessment, ranked
                                   [--purpose regular|prod-staging|demo] [--scope app|all]
                                   [--bundles] [--out DIR]; or one part of it:
                                   promote lanes|commits|tickets|evidence|bundles <line> <from> <to>
  ela promote constraints          the owner's standing constraints, each pin read on its lane now
  ela promote close                the pending promotion is done: the morning stops showing its next train
                                   (a report written with --out opens or refreshes it)
  ela promote plan <line> <from> <to> --on YYYY-MM-DD --after "<condition>" [--carry KEY…]
                                   a planned promotion on the pending record (local file only): the lanes block, the
                                   next-train column and the report show it; each pass re-checks the carried keys
                                   (merged into release<line> per repo · named by the newest QA build · its QA report)
 sessions
  ela session open <alias|path> [--name N] [--tab|--pane] [--in-place] [--brief FILE|--no-brief] [--permission-mode M] "brief"
                                   a worker session where the target's rules live: a stacked pane in the workers tab
                                   (made when missing), titled with its name; --tab its own tab; --pane beside this
                                   pane (a topic session); --brief FILE points the first message at a brief; a name a
                                   live session holds is refused; the layout goes to <runtime>/sessions/; needs zellij.
                                   On ela or runner it needs --name N and starts the worker in <work>/N/<repo> on
                                   branch evan/N, never in the shared checkout; --in-place opens the checkout for a look;
                                   there it refuses without --brief FILE or the brief (--no-brief: none, on purpose)
  ela session land <name> [--repo ela|runner] [--dry-run]
                                   bring evan/N into the shared checkout: rebase on origin/main, tests/run.sh in the
                                   worktree, fast-forward main only when no dirty file there overlaps, push, remove the
                                   worktree; any failed step refuses with its reason and main stays
  ela session close <name>         end a live session: its Claude process, then its pane; the registry says closed by desk
  ela session reap [--apply] [--json] | --last
                                   each live session's state from git and its transcript: desk · runner · dirty · to-land ·
                                   pending (`⏳ ela pending · …`) · no-brief · landed · signed-off (`— ela out 🦀`) ·
                                   waiting-owner (its question or `⚖️ Needs your decision`) · busy,
                                   with minutes since its last reply; --apply, idle 10 minutes: land a to-land whose reply
                                   says ready (once; a refusal is shown), close the landed and the signed-off with nothing
                                   to land; never the desk, a hand-started, busy, dirty, pending,
                                   waiting or brief-less one;
                                   --last the sessions the last --apply left open (the desk's session start shows them)
  ela session list                 the sessions on this machine, newest first: name, cwd, started, ended, purpose
  ela session here [--json]        this session's id and /rename name
  ela session usage [--since 7d] [--by kind|name|day|cwd|model] [--top 10] [--json]
                                   what the sessions cost, from Claude Code's transcripts: tokens (cache read and write,
                                   input, output), the recorded cost, turns, tools and skills, grouped; the costliest listed
  ela sessions <word>…             earlier sessions on this machine whose first prompt or final
                                   answer carries every word
  ela pick <path>… [--file F]      fields out of JSON, from a verb's --json on stdin or a file, with no interpreter:
                                   no path prints the shape; rows[].key .status one tab-separated line per row;
                                   [N] [A:B] [] ** @key; --where K=V|K!=V|K~V, --count, --shape, --max N; a file
                                   in the site directory is refused · ela brief --json | ela pick lanes[].@key .count

协调 — facts and drafts for the team
  ela brief [--lane L]             the morning brief's Jira lanes, flags computed: cadence ·
                                   triage · breakdown · incidents · backlog · yours
  ela yesterday [--hours N]        what changed, joined into cases by ticket key: Jira moves, commits,
                                   Slack; commits and threads with no ticket; what ela did
  ela changes [--hours N]          the day's real changes for the Changes page: lane moves, builds and the
                                   commits they carry, release and QA mail, the release thread, commits per
                                   repo and ticket, what you did, the team report; sources not read named
  ela matrix                       which version runs on which lane: prod / daily / QA by component, ▲ a move
                                   since yesterday, QA's mark on that exact version, a pin's 🔒 or ⛔
  ela matrix --page                the lanes page in the vault: that table, what each lane carries that the next
                                   does not (tickets, QA verdicts, commits without a ticket), 14 days of moves
  ela recent [--days 7] [--write]  the week's MH tickets placed by release line (the line's train, where each fix
                                   stands, what QA said, what moved) and by lane; --write keeps the result under
                                   <reports>/recent/ and the vault's sync renders the recent page from it
  ela teamreport prompt|write|compare|show daily|weekly [--date D | --week YYYY-Www]
                                   the team's daily and weekly report narrative from the fact store: prompt (the
                                   writing rules and the data, for a model), write (checked and published to
                                   <published>/reports/, which Helm renders and posts; ela posts nothing), compare
                                   (Helm's report and ela's side by side, <runtime>/drafts/report-compare/)
  ela train --line 2.1 [--json] [--write] [--page] [--parity]
                                   the line's train: one row per fix with a cell per lane (qa · daily · prod · the aligned
                                   CN lane): the build that carried it there, the lane's verdict, its position, a
                                   regression; --write keeps <reports>/train/<line>.json, --page writes lanes/train-<line>.md,
                                   --parity compares its QA view with the lane's test list (exit 1 when they differ);
                                   each row carries QA's failed case and its impact on the next move (blocks, your
                                   call, not yet verified, does not block, ready), shown on the line page
  ela train answer impact:<KEY> A|B [--why TEXT]
                                   rule on a your-call fix: A agrees with ela's leaning, B the other way; kept with its
                                   kind in <reports>/train/rulings.jsonl as the next case's precedent
  ela onething facts --date D | --month YYYY-MM   the owner's own Jira actions and Slack messages per day, for
                                   his One Thing rows; sheet --month (rows already there) · render --rows F (the day's
                                   entry into the store <reports>/onething/) · block --date D (the day's section for
                                   the changes page) · apply --date D --lines F (his rewording and pasted ticks) ·
                                   post --date D | --month M (the lines he pastes, printed) · import NOTE (a vault
                                   note's table into the store); ela never writes to the sheet
  ela day [--date D]               the owner's day as data (<elak>/blueprint/meetings.yaml): working day, hours, DM
                                   window, QA deploy hour, the meetings that day and their brief section headings
  ela focus board|moves|scrum|hold|resume|holds|up|down   MediaHub's focus as one board (meetings/focus.md): one row
                                   per item, Jira priority then due date; a meeting is a view of it (at most 7 rows);
                                   hold/resume park a subject on every page; up/down ask for a Jira priority move;
                                   moves and scrum (the Read AI report after the scrum) draft one dry-run batch, asked
                                   A/B on today.md — nothing reaches Jira before his A
  ela watch scan|prompt|decide|answer|asks|dm|track|measure   the whole MH board watched (decision 2026-11-24): every open ticket
                                   tracked each pass, the triggered ones (a change, a question, a wrong assignee or
                                   status, a stall; the owner's first) decided by a session (/ela:watch); decide
                                   --from F carries them: an act is ela's own signed Jira set (dry run until --apply,
                                   one per ticket a day, listed in ela/dry/did.md with its undo), an ask a topic for you
                                   on ela/watch.md, answered in the CLI (dm: a reminder, at most one a day when one is new);
                                   track|untrack KEY… [--why T] [--until D]: a ticket due a decision on any human change;
                                   measure: the weekly share ela settled without you (ela/watch-measure.md)
  ela meeting --key K              a meeting's note in the vault (meetings/<key>.md): --raise / --propose TEXT add an
                                   item (140 characters at most, --detail folds under it), --rule moves ruled and
                                   dropped items under Ruled by date, --slack the list as Slack writes it, --json with
                                   the send box, the channel, the thread and the morning page's pointer line
  ela page-check PAGE --actions F  every apply N on a brief page has its drafted action and its box; exit 1 naming any
  ela review lint PAGE              a page ela wrote, checked mechanically: keys are links, Do lines are boxes and
                                   never left for you, counts equal the day's, one item per key, services by slug
  ela review replay --date D       what ela said on D against the sources now: sure readings undone, versions
                                   miscalled, nudges already answered, applied actions with no change; one line
  ela review reader --date D [--check]   the evening reader session's inputs (brief SKILL §reader), or a check of
                                   what it wrote: one verdict per item, the page's three lines
  ela testlist [--lane L] [--page] what QA should verify, per lane (every lane without --lane; a prod lane is a
                                   release check): one row per behaviour (owner ticket, or "no ticket" flagged), ranked
                                   P1–P3 with the reason, first build → lane build, how to verify, auto, QA's verdict
                                   (version + date), ela saw; --new-rows: a build's new rows for its thread;
                                   --saw KEY "line": the night run's result on the row (a local write)
  ela devlist [--line 2.1] [--page] every owner ticket in development on a line (every line without --line): branch
                                   state, build, QA verdict, what the train needs (ticket · Fixed In · verdict), gaps
  ela ticket refresh KEY|--all     each change on a tracked ticket since the last pass, read as sure (a rule
                                   in probe §fix) or unsure; appended to its fix page; findings for the brief
  ela dry status|classes|seed|draft|batch|asks|answer|correct|did|undo|acts
                                   dry runs by class: each kind of write's record (applied as drafted, edited,
                                   cancelled, expired, corrected), its tier, what is one step from maturity; draft
                                   link-named|parent-status <KEY> [--apply] writes them as ela's own, signed (tier 1
                                   by decision; a batch asked only after a correction); answer <ask> A|B|C
                                   is his letter (A on a batch is a dry run until --apply); correct returns a granted
                                   class to confirm; undo <act|batch> takes an act back from the before-state it kept
                                   (dry run until --apply), and records the correction; a class without its reverse
                                   atom is never proposed for a grant
  ela mention list|show|triage|facts|draft|answer|follow|close|supersede|tally <id|permalink>
                                   a mention of you in Slack, watched through your reply (ADR 0021): triaged (ask ·
                                   incident · notice) with the reason kept; you go first; your reply's commitments
                                   prepared as dry runs by class; unanswered after 30 working minutes, one message
                                   with the facts, a drafted reply and A / B / C; scan|note|due|sent are the
                                   runner's. answer <id> A posts the draft the card showed when site.json
                                   mention_post_as is ela or owner (ADR 0022; off: you paste it); it is the one
                                   verb that writes to Slack; supersede marks the Slack actions drafted for a
                                   closed mention's thread
  ela asks precedents|fact         what you taught ela by answering its asks: precedents [--domain dry|watch|mention]
                                   [--kind K] your corrections kept with their cause, read from each domain's own store;
                                   fact get|list|give the facts you gave, by kind and key (give: dry run unless --apply;
                                   --durable writes elak, on your word), looked up before a fact is asked again
  ela improve digest|add|list|answer|done|section|pending|corpus
                                   what the assistant as a whole should do better (ADR 0023): digest --date D the
                                   day's signals (mediahub-bot's runs, ela's jobs and follow-ups, failed units, his
                                   feedback, token spend by kind of session and files re-read); add FILE --date D at most three proposed items, checked; an item whose
                                   fix would send, post or write to Jira waits for your letter on today.md (answer
                                   <id> A|B, ADR 0024); any other, a bot's answers included, starts as go; done <id> --what TEXT once it lands; section --date D the
                                   reader page's Improve lines; pending one line for the desk session. Nothing is
                                   deleted, nothing written live
  ela radar fetch|prompt|write|summary|sources   what is new in Claude and AI tooling, weekly (plan
                                   ela/2026-11-26-plan-weekly-ai-radar): fetch reads the source table by code within
                                   its caps; prompt the judge's input; write --input F renders <reports>/radar/<date>.md
                                   from the judge's JSON and only then moves the marks; --since/--topic make a preview
                                   that moves none; `ela-runner radar` runs the pass
  ela vault sync [--dry-run]       regenerate the owner's Obsidian vault: day pages, readings, verifications,
                                   decisions and plans; a note over its reading budget carries a warning;
                                   a note you delete is done and stays deleted (ela vault restore PATH)
  ela vault head [--lines F] [--apply] [--json]   today.md's head: the inputs the last sync saw, the day's judgment,
                                   the rules; --lines judges a session's answer line by line, --apply keeps what passes
  ela vault setup                  apply the vault's Obsidian settings from ela's versioned copy, then restart Obsidian
  ela vault guidance [--json]      the owner's `ela:` lines and ticked boxes anywhere in the vault, each handled once
  ela vault answer N A|B|C [--apply]  one letter on today's ask N from anywhere (Slack, a session), as a tick on
                                   today.md: prints the runner's command, or settles a drop or a dry answer itself
  ela vault finish PATH [--to drop|archive]   on your word: close a note into the archive, kept
  ela vault lint [--fix [--apply]]  every note against its type's spec (the readme's Note standards), one line per
                                   deviation; --fix normalises a title's quoting, links and alias, a dry run unless --apply
  ela note claim|release|stamp|progress|built|move PATH   a note's life from any session: claim it, stamp the session
                                   (id and /rename name) on it, record progress, mark it built, move it
  ela vault marks [--dry-run]      finish the to-read notes whose done or drop box you ticked
  ela vault afterwards [--since D] [--json]   what happened after a note left to-read (its posted threads' replies, its
                                   keys' moves), one dated line a day under its Afterwards; the runner calls it at 12:30, 17:30, 19:00
  ela project list|show KEY|new KEY [--deadline D]|keys KEY --add MH-…   the projects (projects/<key>/ in the vault): each
                                   with its deadline, days left and open asks; one page's state; a new folder and page
                                   with the head skeleton; the keys its page watches (ela vault sync renders the page)
  ela secret NAME                  in your terminal: a credential typed at a prompt that does not echo, written to
                                   the site env file; never paste a token into a chat
  ela route <KEY>                  the routing facts: [Layer] token, ids, signal words per layer,
                                   services named, who to ask first, gaps
  ela stage <KEY>… [--jql Q]       the board against the builds: where each fix is (none/qa/daily/prod),
                                   what the ticket still owes, grouped by action; an Epic expands;
                                   --days N: fix on prod this long → close candidate (default 30)
  ela fixed-in <KEY>… [--jql Q]    the Fixed In the evidence supports: commits → build → lanes
                                   → QA words; draft only, no Jira write
  ela links <KEY|permalink|lane/build>  what links to it, one screen: linked in Jira · named with it (with where) · threads
                                   (channel, date, first line, replies, deploy posts) · builds and lanes · ela's writes (when,
                                   what, who, on whose word) · vault notes; each line its source, the index's age on top;
                                   co-occurrence, never cause. links rebuild|update|status: the index (<runtime>/links/),
                                   updated after every facts refresh
  ela team <verb>                  the roster, first-hand: people|areas|who|emails|check
  ela who <person>                 one person by name, email, Uxxx or accountId; exit 3 when unknown
  ela publish <what>               render an elak source into <published> for machines to read:
                                   catalogue|roster|map|all|list; the manifest row records it;
                                   mirror [--dry-run]: the read-only Obsidian copy (site.json
                                   published_mirror), refreshed after every publication anyway
  ela reports list|build           the owner's standing reports (markdown → HTML; a session
                                   publishes them as artifacts)

动手 — the owner's own change
  ela worktree <repo> <KEY>        branch evan/<key> in <work>/<KEY>/<repo>
  ela mr <KEY> <repo> [--lane B]   the push and the merge-request request for evan/<key>,
                                   dry run only
  ela mr-preflight [--host H]      each GitLab token's scopes and expiry (needs scope api)

运行操作 — writes on a live system, each behind a confirm
  ela connect <ip|box|process>     ssh to the box (root)
  ela exec <process>               docker exec into it
  ela start <process> …            --url U --format F --shm S; a Sender working process; asks y/N
  ela stop <process>               stop a Sender working process; asks y/N
  writes elsewhere:                jira comment|transition|label|link|fixed-in|assign|create|create-subtask|
                                   attach|detach|describe|close (close proposes: Fixed In, labels, comment, the flag, to you),
                                   slack post (a permalink replies in-thread), kb write|update|
                                   delete (on the owner's word) — dry run until --apply
  ela slack join <channel>         the bot joins a public channel at once (its members see it); typing it is the confirm

站点
  ela doctor [--only S,…] [--json] does everything of ela work here? site · units · timers · senses · facts, one
                                   line each (✓ ! ✗), the next action on a failure; exit 1 on any ✗; read-only
  ela login tvu|qa|cn              prod: a one-time HTTPS page collects the browser's SID;
                                   then --host prod on bundles, bundle, versions, drift
                                   cn: proves the China host's address and account (site.json
                                   services.userservice-cn.url, TVU_CN_ACCOUNT / TVU_CN_PASSWORD)
  ela site                         the site config: roots, host names, aliases, emails
  ela runtime status|clean         the disposable working directory: what is there, and delete
                                   it (--work also drops clean worktrees)

Every verb forwards to skills/<cap>/<cap>.py with the site's env file.
`--json` works everywhere.
Exit codes: 0 ok · 2 usage · 3 not found · 4 auth · 5 remote.
"""
import json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SITE = os.path.expanduser("~/.claude/ela/site.json")

# verb → (capability, subcommand or None = pass verb through)
VERBS = {
