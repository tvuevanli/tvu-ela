{
  "app": {
    "defaultViewMode": "preview",
    "showInlineTitle": false,
    "readableLineLength": true,
    "strictLineBreaks": false,
    "showFrontmatter": false,
    "propertiesInDocument": "hidden",
    "alwaysUpdateLinks": false,
    "newFileLocation": "root",
    "promptDelete": true,
    "useMarkdownLinks": false,
    "userIgnoreFilters": [
      "ela/attachments/"
    ]
  },
  "appearance": {
    "enabledCssSnippets": [
      "ela"
    ]
  },
  "core_on": [
    "backlink",
    "bases",
    "bookmarks",
    "command-palette",
    "file-explorer",
    "file-recovery",
    "global-search",
    "outgoing-link",
    "outline",
    "page-preview",
    "properties",
    "switcher",
    "webviewer"
  ],
  "community": [
    "homepage",
    "obsidian-html-plugin"
  ],
  "bookmarks": [
    {
      "path": "home.md",
      "title": "Home"
    },
    {
      "path": "board.md",
      "title": "Board"
    },
    {
      "path": "library/library.md",
      "title": "Library"
    },
    {
      "path": "ela/all-notes.base",
      "title": "All notes"
    },
    {
      "path": "ela/how-ela-runs.md",
      "title": "How ela runs"
    },
    {
      "path": "ela/about-this-vault.md",
      "title": "About this vault"
    }
  ],
  "plugins": {
    "homepage": {
      "version": "4.5.0",
      "repo": "mirnovov/obsidian-homepage",
      "files": [
        "main.js",
        "manifest.json",
        "styles.css"
      ]
    },
    "obsidian-html-plugin": {
      "version": "1.0.19",
      "repo": "nuthrash/obsidian-html-plugin",
      "files": [
        "main.js",
        "manifest.json"
      ]
    }
  },
  "core_options": {
    "webviewer": {
      "openExternalURLs": false,
      "enableAdblocking": true
    }
  },
  "types": {
    "done": "checkbox",
    "learn": "checkbox",
    "drop": "checkbox"
  }
}
